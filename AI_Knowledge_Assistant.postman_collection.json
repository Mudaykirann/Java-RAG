      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"content\": \"Spring AI provides an abstraction layer over diverse AI providers like OpenAI, Azure, and Anthropic. It introduces portable VectorStore abstractions such as PgVector, Pinecone, and Chroma, allowing developers to switch underlying vector engines with zero application code changes.\"\n}"
        },
        "url": {
          "raw": "http://localhost:8081/api/ai/documents",
